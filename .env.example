# ═══════════════════════════════════════════════════════════════════════
#  OpenHarmony 日志智能聚合分析工具 —— 本地密钥配置
#
#  ★ 本文件是模板，会入库；真正的 .env 已被 .gitignore 忽略，不会提交 ★
#  ★ 千万不要把 Key 写进代码或提交到 Git ★
#
#  用法：
#    1. 去 https://platform.deepseek.com/api_keys 申请 API Key
#    2. 把下面那行的 sk-xxxx 换成你的真实 Key（保留引号）
#    3. 保存。之后 run.ps1 / 启动器 / 看板服务启动时都会自动加载
#
#  格式说明：
#    KEY=VALUE，等号两边不要有空格，值不要加引号
# ═══════════════════════════════════════════════════════════════════════

DEEPSEEK_API_KEY=sk-在这里粘贴你的Key

# ---- 可选：LLM 配置（不填则用默认值）----
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DAILY_BUDGET_CNY=5.0

# ═══════════════════════════════════════════════════════════════════════
#  告警通知（可选）—— 不配也能跑：默认只有控制台 + logs/alerts.jsonl
#
#  文档：docs/13-alerting.md（策略、邮件可行性、常见故障排查）
#  自测：.venv\Scripts\python.exe -m agri_logger.notifier --show-config
#
#  ★ SMTP_PASSWORD 填的是【授权码】，不是邮箱登录密码！
#     QQ 邮箱：设置 → 账号 → 开启 IMAP/SMTP 服务 → 发短信 → 得到 16 位授权码
# ═══════════════════════════════════════════════════════════════════════

# ---- 总开关与策略 ----
ALERT_ENABLED=1
# 低于此级别只写审计文件、不推送：P0 > P1 > P2 > P3
ALERT_MIN_SEVERITY=P2
# 1 = 演练模式：只显示会发什么，不真的发（答辩前彩排用）
ALERT_DRY_RUN=0
# 同一异常族的冷却秒数（防止一次故障连发十几封）
ALERT_COOLDOWN_S=180
# 每小时最多推送几条
ALERT_MAX_PER_HOUR=12

# ---- 邮件（不填 = 不启用，不算错误）----
# ALERT_EMAIL_ENABLED=1
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=你的QQ号@qq.com
# SMTP_PASSWORD=在这里填授权码
# ALERT_EMAIL_FROM=你的QQ号@qq.com
# ALERT_EMAIL_TO=收件人@example.com

# ---- Webhook（钉钉/飞书/企业微信群机器人，复制 URL 即可）----
# ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# auto | dingtalk | feishu | wecom | generic（默认 auto，按 URL 自动识别）
# ALERT_WEBHOOK_KIND=auto
