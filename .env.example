# ═══════════════════════════════════════════════════════════════════════
#  OpenHarmony 日志智能聚合分析工具 —— 本地密钥配置
#
#  ★ 这个文件已被 .gitignore 忽略，不会提交到仓库 ★
#  ★ 千万不要把 Key 写进代码或提交到 Git ★
#
#  用法：
#    1. 去 https://platform.deepseek.com/api_keys 申请 API Key
#    2. 把下面那行的 sk-xxxx 换成你的真实 Key（保留引号）
#    3. 保存。之后用 run.ps1 跑脚本时会自动加载
#
#  格式说明：
#    KEY=VALUE，等号两边不要有空格，值不要加引号
# ═══════════════════════════════════════════════════════════════════════

DEEPSEEK_API_KEY=sk-在这里粘贴你的Key

# ---- 可选：LLM 配置（不填则用默认值）----
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DAILY_BUDGET_CNY=5.0
