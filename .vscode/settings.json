{
  // ────────────────────────────────────────────────────────────────────────
  // OpenHarmony 日志智能聚合分析工具 —— 团队共享的 VSCode 配置
  //
  // 本项目使用【仓库内的虚拟环境】.venv（用本机任意 Python 3.8+ 创建）
  //   <仓库根目录>\.venv\Scripts\python.exe
  //
  // 为什么用虚拟环境，而不是直接指向某个系统 Python？
  //   ① 路径在仓库内，组里每台电脑都一样，本配置提交后全组直接生效；
  //      C:\Users\<用户名>\... 只存在于各自电脑上，无法共享。
  //   ② 不写任何系统 Python 的 site-packages，绕开 Windows 跨账户
  //      AppData 的写权限问题（实测：跨用户 pip install 会报 WinError 5）。
  //   ③ 依赖（pyserial 等）与系统环境隔离，不会因为别人装了什么而互相干扰。
  //   ④ 直接解决了"中文用户名路径"问题：.venv 在 E: 盘，路径全 ASCII。
  //
  // ── 每台电脑首次使用（克隆 / 拷贝仓库后执行一次）───────────────────────
  //   python -m venv .venv                                   # 用本机任意 3.8+ 创建
  //   .venv\Scripts\python.exe -m pip install -r requirements.txt
  //   ⚠️ .venv 不能跨电脑拷贝：它内部记着【原电脑 Python 的绝对路径】，
  //      换机器后启动会报 No Python at 'C:\Users\...\python.exe'。
  //      最省事的做法：直接运行 start_dashboard.cmd——它会找到本机 Python，
  //      重建 .venv 并装好 requirements.txt 里的依赖。
  //
  // ── 在终端里用它 ──────────────────────────────────────────────────────
  //   .venv\Scripts\Activate.ps1        # 激活后直接敲 python 即可
  //   若提示禁止运行脚本，执行一次：
  //     Set-ExecutionPolicy -Scope CurrentUser RemoteSigned
  //
  // ⚠️ 关键：VSCode 里选解释器只影响【编辑器内的运行/调试按钮】和 Pylance 补全，
  //          【不影响终端里敲 python 用哪个】。终端看 PATH / 是否激活，见 README §0.5。
  // ────────────────────────────────────────────────────────────────────────

  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

  // Pylance / 语言服务
  "python.languageServer": "Pylance",

  // 让 VSCode 自动激活 .venv，省去手动 Activate
  "python.terminal.activateEnvironment": true,

  // 终端里跑 pytest 时用同一个解释器（若日后装了 pytest）
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // 采集器的日志输出目录，避免 VSCode 搜索/监视时被日志刷屏
  "files.watcherExclude": {
    "**/logs/**": true,
    "**/data/**": true,
    "**/.cache/**": true
  },
  "search.exclude": {
    "**/logs": true,
    "**/data": true,
    "**/.venv": true,
    "**/Tool": true,
    "**/harmony_sdk": true,
    "**/.cache": true
  },

  // .cmd / .bat 启动器是 GBK（cp936）编码，别让 VSCode 按 UTF-8 读写：
  // cmd.exe 在 chcp 65001 下解析含中文的批处理会"行错位"，所以那些文件
  // 必须存成 GBK。这里指定 bat 语言的编码，打开不乱码、保存不破坏。
  "[bat]": {
    "files.encoding": "gbk"
  },

  // SDK 源码树很庞大，关掉文件关联的干扰
  "files.associations": {
    "*.gn": "gn",
    "*.gni": "gn"
  }
}
